# development / production。production のときは SECRET_KEY と TRUSTED_HOSTS が必須になり、
# Cookie は HTTPS のときだけ送られる
APP_ENV=development
# 本番では必ず設定する（作り方: uv run python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=
# 本番のドメイン（カンマ区切り）
TRUSTED_HOSTS=
# 省略すると instance/harvest.sqlite
DATABASE_URL=
# Stripe（テストモードのキーは sk_test_ で始まる）。https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook の署名シークレット（whsec_ で始まる）。開発では `stripe listen --forward-to localhost:8001/stripe/webhook` が表示する値
STRIPE_WEBHOOK_SECRET=
